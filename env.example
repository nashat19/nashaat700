# بيانات الحساب (تتجاوز config.yaml)
INSTARASHQ_USERNAME=your_account
INSTARASHQ_PASSWORD=your_password
# بروكسي اختياري: http://user:pass@host:port
INSTARASHQ_PROXY=
# مسار ملف الجلسة
INSTARASHQ_SESSION_FILE=.sessions/default.json
# مسار قاعدة البيانات
INSTARASHQ_DB=data/instarashq.db
# مستوى السجلات
INSTARASHQ_LOG_LEVEL=INFO
# مفتاح تشفير الجلسة (اختياري، يفعّل تشفير Fernet لملف الجلسة)
INSTARASHQ_SESSION_KEY=
